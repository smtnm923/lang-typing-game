                  </Button>
               </children>
               <StackPane.margin>
                  <Insets />
               </StackPane.margin></VBox>
            <VBox fx:id="resultPane" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0" visible="false">
               <children>
                  <Label text="ゲームクリア！">
                     <font>
                        <Font size="28.0" />
                     </font>
                     <VBox.margin>
                        <Insets />
